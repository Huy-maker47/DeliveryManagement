@model DeliveryManagement.Models.ViewModels.CreateOrderViewModel

@{
    ViewData["Title"] = "Tạo yêu cầu giao hàng";

    var packageTypes = ViewBag.PackageTypes
        as List<DeliveryManagement.Models.PackageType>
        ?? new List<DeliveryManagement.Models.PackageType>();
}

<div class="order-create-page">

    <div class="order-create-header">
        <div>
            <h1>Tạo yêu cầu giao hàng</h1>
            <p>Nhập thông tin để tạo yêu cầu giao hàng mới</p>
        </div>
    </div>

    <form asp-controller="DeliveryOrder"
          asp-action="Create"
          method="post"
          class="order-form">

        <div asp-validation-summary="All"
             class="text-danger validation-summary"></div>


        <!-- =========================
             THÔNG TIN NGƯỜI GỬI
             ========================= -->

        <div class="order-section">

            <div class="order-section-header">
                <h2>1. Thông tin người gửi</h2>
            </div>

            <div class="order-form-grid">

                <div class="form-group">

                    <label asp-for="SenderName"
                           class="form-label">
                        Họ và tên
                    </label>

                    <input asp-for="SenderName"
                           class="form-control"
                           placeholder="Nhập họ và tên người gửi" />

                    <span asp-validation-for="SenderName"
                          class="field-validation-error"></span>

                </div>

                <div class="form-group">

                    <label asp-for="SenderPhone"
                           class="form-label">
                        Số điện thoại
                    </label>

                    <input asp-for="SenderPhone"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="SenderPhone"
                          class="field-validation-error"></span>

                </div>

            </div>

            <div class="form-group">

                <label asp-for="SenderAddress"
                       class="form-label">
                    Địa chỉ
                </label>

                <input asp-for="SenderAddress"
                       class="form-control"
                       placeholder="Nhập địa chỉ người gửi" />

                <span asp-validation-for="SenderAddress"
                      class="field-validation-error"></span>

            </div>

        </div>


        <!-- =========================
             THÔNG TIN NGƯỜI NHẬN
             ========================= -->

        <div class="order-section">

            <div class="order-section-header">
                <h2>2. Thông tin người nhận</h2>
                <p>Nhập thông tin người sẽ nhận hàng</p>
            </div>

            <div class="order-form-grid">

                <div class="form-group">

                    <label asp-for="ReceiverName"
                           class="form-label">
                        Họ và tên
                    </label>

                    <input asp-for="ReceiverName"
                           class="form-control"
                           placeholder="Nhập họ và tên người nhận" />

                    <span asp-validation-for="ReceiverName"
                          class="field-validation-error"></span>

                </div>

                <div class="form-group">

                    <label asp-for="ReceiverPhone"
                           class="form-label">
                        Số điện thoại
                    </label>

                    <input asp-for="ReceiverPhone"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="ReceiverPhone"
                          class="field-validation-error"></span>

                </div>

            </div>

            <div class="form-group">

                <label asp-for="ReceiverAddress"
                       class="form-label">
                    Địa chỉ nhận hàng
                </label>

                <input asp-for="ReceiverAddress"
                       class="form-control"
                       placeholder="Nhập địa chỉ người nhận" />

                <span asp-validation-for="ReceiverAddress"
                      class="field-validation-error"></span>

            </div>

        </div>


        <!-- =========================
             HÌNH THỨC GIAO HÀNG
             ========================= -->

        <div class="order-section">

            <div class="order-section-header">
                <h2>3. Hình thức giao hàng</h2>
                <p>Chọn hình thức giao hàng phù hợp.</p>
            </div>

            <div class="delivery-method-list">

                <label class="delivery-method-option">

                    <input asp-for="DeliveryMethod"
                           type="radio"
                           value="Thường" />

                    <span>
                        <strong>Giao thường</strong>
                        <small>
                            Giao theo tuyến, chi phí thấp hơn
                        </small>
                    </span>

                </label>

                <label class="delivery-method-option">

                    <input asp-for="DeliveryMethod"
                           type="radio"
                           value="Nhanh" />

                    <span>
                        <strong>Giao nhanh</strong>
                        <small>
                            Giao riêng, thời gian nhanh hơn
                        </small>
                    </span>

                </label>

            </div>

            <span asp-validation-for="DeliveryMethod"
                  class="field-validation-error"></span>

        </div>


        <!-- =========================
             THANH TOÁN
             ========================= -->

        <div class="order-section">

            <div class="order-section-header">
                <h2>4. Thanh toán</h2>
                <p>Chọn phương thức thanh toán cho đơn hàng.</p>
            </div>

            <div class="payment-method-list">

                <label class="payment-method-option">

                    <input asp-for="PaymentMethod"
                           type="radio"
                           value="Thanh toán khi giao hàng" />

                    <span>
                        <strong>Thanh toán khi giao hàng</strong>
                        <small>
                            Thanh toán khi hàng được giao
                        </small>
                    </span>

                </label>

                <label class="payment-method-option">

                    <input asp-for="PaymentMethod"
                           type="radio"
                           value="Thanh toán trực tuyến" />

                    <span>
                        <strong>Thanh toán trực tuyến</strong>
                        <small>
                            Thanh toán trước khi hàng được giao
                        </small>
                    </span>

                </label>

            </div>

            <span asp-validation-for="PaymentMethod"
                  class="field-validation-error"></span>

        </div>


        <!-- =========================
             THÔNG TIN HÀNG HÓA
             ========================= -->

        <div class="order-section">

            <div class="order-section-header d-flex justify-content-between align-items-start">
                <div>
                    <h2>5. Thông tin hàng hóa</h2>
                    <p>Có thể thêm nhiều loại hàng trong cùng một đơn</p>
                </div>

                <button type="button" id="btnAddItem" class="btn btn-outline-primary btn-sm">
                    Thêm hàng hóa
                </button>
            </div>

            <div id="itemList"></div>

        </div>


        <!-- =========================
             TỔNG TIỀN
             ========================= -->

        <div class="order-section order-total-section">

            <div class="order-total-content">

                <div>
                    <h2>Tổng tiền</h2>

                </div>

                <div class="order-total-value">
                    Tính theo bảng giá khi tạo đơn
                </div>

            </div>

        </div>


        <!-- =========================
             ACTION
             ========================= -->

        <div class="order-form-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn-cancel">
                Hủy
            </a>

            <button type="submit"
                    class="btn-submit-order">
                Tạo yêu cầu giao hàng
            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const packageTypes = @Html.Raw(Json.Serialize(packageTypes.Select(p => new { id = p.PackageTypeId, name = p.TypeName })));
            const initialItems = @Html.Raw(Json.Serialize(Model.Items));
            const list = document.getElementById('itemList');

            function esc(s) {
                return String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
            }

            function addRow(it) {
                it = it || {};
                const opts = packageTypes.map(p =>
                    `<option value="${p.id}" ${p.id === it.packageTypeId ? 'selected' : ''}>${esc(p.name)}</option>`).join('');

                const row = document.createElement('div');
                row.className = 'item-row border rounded p-3 mb-3';
                row.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="item-title"></strong>
                        <button type="button" class="btn btn-link text-danger p-0 btn-remove">Xóa</button>
                    </div>

                    <div class="order-form-grid">
                        <div class="form-group">
                            <label class="form-label">Loại đóng gói</label>
                            <select name="Items[0].PackageTypeId" class="form-control" required>
                                <option value="">Chọn loại đóng gói</option>${opts}
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Kích thước</label>
                            <input name="Items[0].Size" class="form-control" placeholder="Ví dụ: 30x20x15 cm" value="${esc(it.size)}" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mô tả hàng hóa</label>
                        <textarea name="Items[0].Description" class="form-control" rows="2" required
                                  placeholder="Mô tả hàng hóa cần giao">${esc(it.description)}</textarea>
                    </div>

                    <div class="order-form-grid">
                        <div class="form-group">
                            <label class="form-label">Số lượng</label>
                            <input type="number" name="Items[0].Quantity" min="1" max="1000" class="form-control" required
                                   value="${it.quantity || 1}" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Khối lượng mỗi món (kg)</label>
                            <input type="number" name="Items[0].Weight" min="0.01" step="0.01" class="form-control" required
                                   placeholder="Ví dụ: 2.5" value="${it.weight || ''}" />
                        </div>
                    </div>

                    <div class="order-checkbox-list">
                        <label class="order-checkbox">
                            <input type="checkbox" name="Items[0].IsFragile" value="true" ${it.isFragile ? 'checked' : ''} />
                            <input type="hidden" name="Items[0].IsFragile" value="false" />
                            <span>Hàng dễ vỡ</span>
                        </label>
                        <label class="order-checkbox">
                            <input type="checkbox" name="Items[0].IsValuable" value="true" ${it.isValuable ? 'checked' : ''} />
                            <input type="hidden" name="Items[0].IsValuable" value="false" />
                            <span>Hàng có giá trị</span>
                        </label>
                    </div>`;

                row.querySelector('.btn-remove').addEventListener('click', function () {
                    row.remove();
                    renumber();
                });

                list.appendChild(row);
            }

            // Đánh lại chỉ số Items[i] liên tục để model binding không bị đứt
            function renumber() {
                const rows = list.querySelectorAll('.item-row');
                rows.forEach(function (row, i) {
                    row.querySelector('.item-title').textContent = 'Hàng hóa ' + (i + 1);
                    row.querySelectorAll('[name]').forEach(function (el) {
                        el.name = el.name.replace(/Items\[\d+\]/, 'Items[' + i + ']');
                    });
                    row.querySelector('.btn-remove').style.display = rows.length > 1 ? '' : 'none';
                });
            }

            document.getElementById('btnAddItem').addEventListener('click', function () {
                if (list.children.length >= 20) return;
                addRow();
                renumber();
            });

            (initialItems.length ? initialItems : [null]).forEach(addRow);
            renumber();
        })();
    </script>

}